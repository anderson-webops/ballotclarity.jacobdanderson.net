# Public runtime values
NUXT_PUBLIC_SITE_URL=https://ballotclarity.example.org
NUXT_PUBLIC_API_BASE=http://127.0.0.1:3001/api
# Public legal display values used on the Terms page.
NUXT_PUBLIC_OPERATOR_LEGAL_NAME=Jacob Anderson
# Optional postal notice address. Leave blank if the protected contact route is the only published notice channel.
# NUXT_PUBLIC_OPERATOR_NOTICE_ADDRESS=
NUXT_PUBLIC_GOVERNING_LAW=State of Georgia
NUXT_PUBLIC_VENUE=state or federal courts located in Georgia
# Server-only protected contact email values used by /api/contact-address.
# CONTACT_ADDRESS is returned only after the same-origin nonce challenge succeeds.
# CONTACT_ADDRESS_SESSION_SECRET signs the short-lived contact nonce session and should be distinct from admin secrets in production.
CONTACT_ADDRESS=hello@ballotclarity.org
CONTACT_ADDRESS_SESSION_SECRET=replace-with-a-long-random-contact-session-secret
# Optional public contact/correction form abuse controls.
# These limit repeated /api/feedback submissions per connection in memory. Values must be positive integers when set.
# PUBLIC_FEEDBACK_RATE_LIMIT_WINDOW_MS=600000
# PUBLIC_FEEDBACK_RATE_LIMIT_MAX=5
# Optional public civic lookup abuse controls.
# These limit repeated /api/location and lookup-enriched route requests per connection in memory. Values must be positive integers when set.
# PUBLIC_LOOKUP_RATE_LIMIT_WINDOW_MS=600000
# PUBLIC_LOOKUP_RATE_LIMIT_MAX=60
# Optional deploy identifier used for stale-client recovery across releases.
# If unset, the front-end falls back to commit/build metadata or a build-time local id.
# NUXT_PUBLIC_BUILD_ID=

# Local infrastructure defaults
POSTGRES_DB=ballot_clarity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET=source-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Server-only admin bridge values
# ADMIN_API_BASE must be a private server-to-server origin the Nuxt server can reach.
# Browser requests to /api/admin/* should terminate at the Nuxt server, not at the Express API directly.
ADMIN_API_BASE=http://127.0.0.1:3001/api
ADMIN_API_KEY=replace-with-a-long-random-internal-key
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# Dedicated authenticated-encryption secrets for the server-only saved lookup cookie and Postgres address cache.
# Use unique random values of at least 32 characters in production; do not reuse admin or provider credentials.
ACTIVE_LOOKUP_COOKIE_SECRET=replace-with-a-long-random-active-lookup-cookie-secret
ADDRESS_CACHE_ENCRYPTION_KEY=replace-with-a-long-random-address-cache-encryption-key
ADMIN_STORE_DRIVER=postgres
ADMIN_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
# ADMIN_DB_PATH=./back-end/data/ballot-clarity.sqlite

# Public source-asset delivery
# Set SOURCE_ASSET_BASE_URL when mirrored source files should be served from object storage or a CDN.
# Example: https://assets.ballotclarity.org/source-files
# Local MinIO example: http://127.0.0.1:${MINIO_PORT}/${MINIO_BUCKET}
# SOURCE_ASSET_BASE_URL=

# One-time bootstrap values for the first persisted admin account
ADMIN_BOOTSTRAP_USERNAME=founder-admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Ballot Clarity Admin
ADMIN_BOOTSTRAP_ROLE=admin

# Civic and AI provider keys
# Keep all of these server-side only. Do not expose paid or quota-limited keys to the browser.
# Census geocoding does not require an API key.
# DATA_API_KEY is the shared api.data.gov credential and can be reused for Congress.gov and OpenFEC.
# Set GOOGLE_CIVIC_FORCE_IPV4=true when the server egresses over IPv6 by default but the Google Civic key is restricted to the server's IPv4.
# Census geocoder defaults can stay at their current values unless you need a specific benchmark or vintage for reproducibility.
# GOOGLE_CIVIC_API_KEY=
# GOOGLE_CIVIC_FORCE_IPV4=false
# DATA_API_KEY=
# CONGRESS_API_KEY=
# OPENFEC_API_KEY=
# OPENSTATES_API_KEY=
# OPENSTATES_FETCH_TIMEOUT_MS=15000
# LDA_API_KEY=
# OPENAI_API_KEY=
# CENSUS_GEOCODER_BENCHMARK=Public_AR_Current
# CENSUS_GEOCODER_VINTAGE=Current_Current

# Optional ballot-content provider integrations.
# Leave these blank unless Ballot Clarity has direct provider access.
# Endpoint/base URLs must use HTTPS in production when set.
# Center for Tech and Civic Life Ballot Information Project endpoint and optional key.
# CTCL_BIP_API_URL=
# CTCL_BIP_API_KEY=
# Ballotpedia API key and optional base URL override.
# BALLOTPEDIA_API_KEY=
# BALLOTPEDIA_API_BASE_URL=
# BallotReady CivicEngine GraphQL endpoint and OAuth/API key.
# BALLOTREADY_API_URL=
# BALLOTREADY_API_KEY=
# Democracy Works Elections API key and optional base URL override.
# DEMOCRACY_WORKS_API_KEY=
# DEMOCRACY_WORKS_API_BASE_URL=

# Launch-directory ingestion snapshot
# Use npm run launch-directory:sync to write this file from provider data.
LAUNCH_DIRECTORY_FILE=./data/launch-directory.local.json
# Default launch probe coordinates point at downtown Atlanta/Fulton for Open States geo matching.
# LAUNCH_PROFILE_LATITUDE=33.7490
# LAUNCH_PROFILE_LONGITUDE=-84.3880

# Imported coverage snapshots
# Use npm run ingest:coverage to write this file from a vetted JSON source.
LIVE_COVERAGE_FILE=./data/live-coverage.local.json
LIVE_COVERAGE_REQUIRED=false
# LIVE_COVERAGE_SOURCE_FILE=./ops/live-coverage.json
# LIVE_COVERAGE_SOURCE_URL=https://internal.ballotclarity.org/coverage/latest.json

# Back-end runtime
PORT=3001
TRUST_PROXY=false
LOG_LEVEL=info
# Admin login abuse controls. Values must be positive integers when set.
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MS=1800000
